SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<db_username>
SPRING_DATASOURCE_PASSWORD=<db_password>

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=true

MAPBOX_TOKEN=<your_mapbox_public_token>

JWT_SECRET=<random_base64_string_min_32_bytes>

VITE_MAPBOX_TOKEN=<your_mapbox_public_token>
SONAR_TOKEN=<your_sonarqube_token>

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://frontend,http://localhost:5173,https://<your-cloud-run-frontend-url>
